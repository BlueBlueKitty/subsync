APP_PASSWORD=test
SECRET_KEY=replace-with-a-long-random-string
TZ=Asia/Shanghai

# For local native run (uvicorn / uv run)
MEDIA_ROOT=/path/to/your/media
DATA_ROOT=/path/to/your/data
PORT=1314
MAX_CONCURRENT_TASKS=1
# Hide low-value GET access logs such as static assets, page loads and read-only polling APIs
QUIET_POLLING_ACCESS_LOGS=true

# For docker-compose host volume mapping
MEDIA_HOST_PATH=/path/to/your/media
DATA_HOST_PATH=/path/to/your/data
